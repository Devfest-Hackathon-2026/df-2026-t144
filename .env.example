# Optional. The MICHI server (Gemini, routes, photo reading) the app talks to.
# Blank: self-contained demo (keyword matching and fixed text, no AI).
# Production from Expo Go: https://michi-176224264627.asia-northeast1.run.app
# Local server from a phone: your computer's LAN address, not localhost.
# Restart Expo after changing it.
EXPO_PUBLIC_API_URL=
# Older name for the same setting; used only when EXPO_PUBLIC_API_URL is blank.
EXPO_PUBLIC_ROUTES_URL=

# Native Maps SDK keys (application-restricted keys; rebuild after changing).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Server-only key. NEVER prefix it EXPO_PUBLIC_.
GOOGLE_ROUTES_API_KEY=

# Maps JavaScript API key for the web map. Public by design: restrict it to
# your site URLs (HTTP referrer) and to the Maps JavaScript API only.
# The server hands it to the web app via GET /v1/config.
GOOGLE_MAPS_BROWSER_KEY=

# Gemini on Vertex AI. On Cloud Run no key is needed (service account).
# Locally, to call the real model:
#   GOOGLE_CLOUD_PROJECT=<project id>
#   GEMINI_ACCESS_TOKEN=<output of `gcloud auth print-access-token`, valid ~1h>
GOOGLE_CLOUD_PROJECT=
GEMINI_ACCESS_TOKEN=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global

# Paid APIs (Gemini, Routes, the browser Maps key) are used only until this
# moment. Blank, malformed or without the +09:00 offset: never used (fail closed).
PAID_API_UNTIL=
# Per day and per process, at most 50 each (larger values are ignored).
MAX_GEMINI_CALLS_PER_DAY=50
# Shares of the Gemini ceiling (default 15 each) so photo reading keeps >= 20.
MAX_TEASER_CALLS_PER_DAY=15
MAX_INTEREST_CALLS_PER_DAY=15
MAX_GOOGLE_CALLS_PER_DAY=50
