# Optional. Keep blank for the self-contained demo.
# Physical phones need your computer's LAN address, not localhost.
EXPO_PUBLIC_ROUTES_URL=

# Native Maps SDK keys (application-restricted keys; rebuild after changing).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Server-only key. NEVER prefix it EXPO_PUBLIC_.
GOOGLE_ROUTES_API_KEY=

# Maps JavaScript API key for the web map. Public by design: restrict it to
# your site URLs (HTTP referrer) and to the Maps JavaScript API only.
# The server hands it to the web app via GET /v1/config.
GOOGLE_MAPS_BROWSER_KEY=

# Gemini on Vertex AI. On Cloud Run no key is needed (service account).
# Locally, to call the real model:
#   GOOGLE_CLOUD_PROJECT=<project id>
#   GEMINI_ACCESS_TOKEN=<output of `gcloud auth print-access-token`, valid ~1h>
GOOGLE_CLOUD_PROJECT=
GEMINI_ACCESS_TOKEN=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global
